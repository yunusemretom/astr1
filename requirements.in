# ASTRO V1 — Python bağımlılıkları (üst seviye)
#
# Bu dosya elle düzenlenir. Sabitlenmiş sürümler için:
#     uv pip compile requirements.in -o requirements.txt
#
# NOT: rclpy, sensor_msgs, std_msgs, diagnostic_msgs, launch, launch_ros ve
# ament_index_python paketleri pip'te YOKTUR; /opt/ros/humble altından gelirler.
# Bu yüzden venv --system-site-packages ile açılmalıdır.
#
# NOT: opencv-python 5.x KULLANILAMAZ. Sistemde (~/.local) 5.0.0.93 ön-sürümü
# kurulu, ancak OpenCV 5 Haar cascade API'sini kaldırdı; face_detector_node
# cv2.CascadeClassifier kullandığı için AttributeError veriyor. Venv 4.x'e
# sabitleyerek sistemdeki 5.0.0'ı gölgeliyoruz.

# ── AI / LLM ────────────────────────────────────────────────
openai                  # ai_brain_node + Whisper API (OpenAI uyumlu her sağlayıcı)
groq                    # ai_brain_node LLM + speech_recognition_node Groq Whisper (opsiyonel import)
python-dotenv           # .env okuma (ai_brain, tts, stt, bringup)
websockets              # OpenAI Realtime WebSocket (gpt-4o-realtime-preview)


# ── Konuşma tanıma (STT) ────────────────────────────────────
faster-whisper          # yerel STT (CUDA/CPU), varsayılan motor
vosk                    # yerel çevrimdışı STT alternatifi

# ── Konuşma sentezi (TTS) ───────────────────────────────────
edge-tts                # Microsoft Neural sesler (internet gerekir)
gTTS                    # Google TTS (internet gerekir)
pyttsx3                 # çevrimdışı yedek
requests                # ElevenLabs REST çağrıları

# ── Ses yakalama ────────────────────────────────────────────
sounddevice             # ReSpeaker mikrofon dizisi yakalama
pyusb                   # ReSpeaker USB kontrol arayüzü
scipy                   # standalone/voice.py resample_to: anti-alias polifaz
                        # yeniden örnekleme (yoksa np.interp'e düşülür, bkz. o dosya)

# ── Donanım / sayısal ───────────────────────────────────────
pyserial                # Arduino Mega seri köprüsü
# x86_64'da sistem/ROS numpy sürümüyle aynı tutulur (ABI uyumu).
numpy==2.2.6 ; platform_machine != "aarch64"
# Jetson'da (aarch64) NVIDIA'nın kendi torch derlemesi NumPy 1.x'e karşı derlenmiştir.
# NumPy 2.x kurulursa torch "Failed to initialize NumPy: _ARRAY_API not found" verir ve
# torch<->numpy dönüşümleri bozulur; bu yüzden orada 1.x serisinde kalıyoruz.
numpy==1.26.4 ; platform_machine == "aarch64"
# NOT: requirements.txt x86_64 için çözüldüğünden bu marker kilide yansımaz;
# aarch64 sabitlemesini scripts/install.sh açıkça uygular.

# ── Test ────────────────────────────────────────────────────
# Sistem pytest'i (/usr/lib/python3/dist-packages) venv'deki anyio eklentisiyle
# çakışıyor ("No module named '_pytest.scope'"); pytest venv'de olmalı.
pytest

# ── Görü ────────────────────────────────────────────────────
opencv-python<5         # face_detector_node Haar cascade kullanıyor (bkz. yukarıdaki not)
